# Copy to .env.local (already gitignored) to opt into live AWS calls.
# Leaving SENTINEL_MODE unset (or anything other than "live") keeps the
# console fully local/mock — no AWS calls are made.

SENTINEL_MODE=live
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Direct-publish SMS target for the "alert my trusted contact" action.
# E.164 format, e.g. +9198XXXXXXXX. India numbers need DLT registration for
# SNS SMS to actually be delivered — see README.
ALERT_PHONE_NUMBER=

# Credentials: do NOT put long-lived IAM access keys here. Mint short-lived
# ones from your existing `aws login` session instead — see README, "Running
# with real AWS credentials".
